# --- secrets / env ---
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx

# --- gradle / android (defence in depth; android/.gitignore also covers these) ---
.gradle/
build/
local.properties
*.keystore
*.jks
*.apk
*.aab

# --- node / web ---
node_modules/
dist/
*.log
npm-debug.log*

# --- IDE ---
.idea/
*.iml
.vscode/

# --- os / misc ---
.DS_Store
Thumbs.db
captures/
.externalNativeBuild/
.cxx/

# --- design working material (local only, never published) ---
# Audit, concept, the framework-capability research and the HTML prototype.
# Kept on disk and out of the repo: it is exploration, not the product, and a
# published app should not ship a 1292-line prototype and its design debates.
.design/
