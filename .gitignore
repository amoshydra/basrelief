# --- secrets / env ---
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx

# --- gradle / android (defence in depth; android/.gitignore also covers these) ---
.gradle/
build/
local.properties
*.keystore
*.jks
*.apk
*.aab

# --- node / web ---
# There are two JS projects: the reference WebGL port and the gallery in web/.
# These patterns are global, so they already cover both node_modules/ and dist/;
# the explicit lines below keep the intent readable.
node_modules/
dist/
reference/webgl-port/node_modules/
reference/webgl-port/dist/
web/node_modules/
web/dist/
*.log
npm-debug.log*

# --- IDE ---
.idea/
*.iml
.vscode/

# --- os / misc ---
.DS_Store
Thumbs.db
captures/
.externalNativeBuild/
.cxx/

# --- python ---
# The node is not a package anyone installs, but its contract test is run in a
# container and a local py_compile leaves these behind. Nothing here ships.
__pycache__/
*.pyc

# --- design working material (local only, never published) ---
# Audit, concept, the framework-capability research and the HTML prototype.
# Kept on disk and out of the repo: it is exploration, not the product, and a
# published app should not ship a 1292-line prototype and its design debates.
.design/
