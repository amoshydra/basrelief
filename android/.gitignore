# Gradle / AGP
.gradle/
build/
app/build/
local.properties

# Android Studio / IntelliJ
.idea/
*.iml

# Release signing — never commit release keystores or their properties
keystore.properties
*.keystore
*.jks

# The throwaway DEBUG key is NOT committed. `podman-build.sh` generates it on
# the host when missing, and the Dockerfile copies it in, so the signature stays
# stable across image rebuilds with no key material in the repository. A
# contributor's debug builds get their own identity, which is what you want:
# theirs must never install over yours.
debug.keystore

# APKs
*.apk
