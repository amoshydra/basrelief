    <string name="settings_licence">MIT</string>
    <!-- The sheet's grip. It has no label on screen, so a screen reader is told
         what it is; "Done" would be a lie, because the bar closes the sheet
         rather than committing anything. -->
    <string name="settings_close">Close settings</string>
    <!-- Spoken state of a settings row. The swatch itself is a coloured dot, which
         no screen reader can interpret, so the state has to be named. -->
    <string name="settings_state_on">On</string>
    <string name="settings_state_off">Off</string>
    <!--
      Reset. Destructive, so it is confirmed on the app's own card like Delete in
      the gallery. The consequence names what goes and what comes back, because a
      reset that only said "reset" would ask the user to guess both.
    -->
    <string name="settings_reset">Reset</string>
    <string name="settings_reset_title">Reset the app?</string>
    <string name="settings_reset_message">Deletes every photo, playlist and setting. The demo comes back.</string>

    <!--
      Depth AI. One screen: server, model, resolution. Three screens for one
      decision is three chances to change your mind, and the endpoint used to be
      hidden behind "discovered automatically" — which is fine until the server
      is on another machine, which it usually is.
    -->
    <string name="depth_title">Generate a depth map</string>
    <string name="depth_panel_subtitle">Runs on your own ComfyUI server. Nothing is uploaded.</string>
    <string name="depth_server">Server</string>
    <string name="depth_server_hint">http://&lt;server&gt;:8188</string>
    <!-- Three strings the panel no longer uses, kept because the PRD still asks for
         them: R-PANEL5 wants the endpoint to be a LINK — a dot, the host, and
         Change — and the signed-off mockup draws a plain field with the stored
         address in it. The mockup wins, so there is no row to label and nothing
         says "not tested" beside a field the user can read. See the class javadoc
         of DepthGenDialog before putting any of them back. -->
    <string name="depth_server_change">Change</string>
    <string name="depth_server_untested">Not tested</string>
    <string name="depth_models_found">%1$d models on this server</string>
    <string name="depth_test_connection">Test connection</string>
    <string name="depth_testing">Testing connection…</string>
    <string name="depth_test_failed">Not reached: %1$s</string>
    <string name="depth_models_untested">Test the connection to load models</string>
    <string name="depth_models_none">No depth models on this server</string>
    <!-- The server has depth nodes, but every one of them needs an input this
         app cannot supply (a model, a mask, or a second image), so the list is
         empty for a reason the old message would misreport. -->
    <string name="depth_models_unusable">No depth model on this server runs from a single image</string>
    <!-- R-PANEL3. Depth results get compared, so a silently changed model makes
         the comparison meaningless; the swap says so. -->
    <string name="depth_model_gone">%1$s is gone — using %2$s</string>

    <string name="depth_model">Model</string>
    <!-- The group heading, and the name on the slider's own label column. Two
         words, because the mockup draws both and only one of them is a caption:
         RESOLUTION heads the group, OUTPUT names the control in it. -->
    <string name="depth_resolution_caption">Resolution</string>
    <string name="depth_resolution">Output</string>
    <string name="depth_resolution_value">%1$d×%1$d</string>
    <!-- Glyph buttons, like the add-photo one: a word here would be longer than
         the control. -->
    <string name="depth_nudge_down">−</string>
    <string name="depth_nudge_up">＋</string>

    <string name="depth_generate">Generate</string>
    <string name="depth_endpoint_required">Set the ComfyUI endpoint first</string>
    <!-- Named for the fact, not for the wording: the panel was opened with no
         photograph to generate for. Reachable two ways — nothing is selected (an
         emptied gallery), or the selected row's file is not on this device. -->
    <string name="depth_no_subject">Open this on a photo from the gallery</string>
    <!-- R-BG3: a run is minutes of upload and polling, and battery saver is
         the OS saying the phone cannot afford it. Said on the note rather than
         by greying Generate, because saver can be flipped while the panel is
         open and no listener re-renders it — and PowerSave.isOn is the one
         read path, so a user who turned "follow battery saver" off never sees
         this at all. -->
    <string name="depth_battery_saver">Battery saver is on — turn it off to generate a map</string>

    <!-- The run. Phases, not controls: the job is queued with the model baked in,
         so a control that appeared to change it could not (R-PANEL7). -->
    <string name="depth_phase_uploading">Uploading the photo</string>
    <string name="depth_phase_queued">Queued on the server</string>
    <string name="depth_phase_working">Working</string>
    <string name="depth_phase_fetching">Fetching the map</string>
    <string name="depth_phase_saving">Saving</string>
    <string name="depth_phase_resuming">Asking the server what happened</string>

    <!--
      A failed run. The headline has to say what SURVIVED: an error that does not
      say that leaves the user unable to tell whether their map is gone, which is
      the worst outcome this app has.
    -->
    <string name="depth_run_cause">The server said: %1$s</string>
    <!-- The subject the failed run was for. One word, because a run can be
         minutes long and the user may have looked at other photos meanwhile — so
         which photo it was FOR is not something they can assume. -->
    <string name="depth_run_was_for">Run for %1$s · your map is unchanged</string>
    <!-- Unused, and gone for the same reason as depth_server_change: its only job
         was to reveal a server field that is now always on screen. -->
    <string name="depth_edit_server">Edit server</string>

    <!--
      The completion notification. R-BG3, decided: a run takes tens of seconds and
      the user has walked away, so silence reads as failure.

      NOTE: this needs android.permission.POST_NOTIFICATIONS to be visible on
      Android 13+. It is NOT in the manifest, so on 33+ the notification is
      suppressed. See DepthGenDialog.notifyOutcome.
    -->
    <string name="depth_notify_channel">Depth generation</string>
    <string name="depth_notify_channel_desc">Tells you when a generated depth map is ready.</string>
    <string name="depth_notify_ready">Depth map ready</string>
    <string name="depth_notify_ready_text">Added to %1$s</string>
    <string name="depth_notify_failed">No depth map</string>
    <string name="depth_notify_failed_text">The server did not answer · your map is unchanged</string>

    <!-- Diagnostics. Read by a person debugging, so still one place. The map's
         filename and the model that produced it live HERE, never in the controls
         (R-D9).

         QUOTED ON PURPOSE. These are prefixes that carry their own trailing
         space, and aapt strips leading/trailing whitespace from an unquoted
         string, so the screen read "Depth:custom image". The quotes are the
         platform's idiom for preserving that space and are removed on compile;
         do not "tidy" them away, and keep the space inside them. -->
    <string name="diag_status_prefix">"Status: "</string>
    <string name="diag_zoom_prefix">"Zoom: "</string>
    <string name="diag_engine_prefix">"Engine: "</string>
    <string name="diag_depth_prefix">"Depth: "</string>
    <!-- The other two columns of the Settings diagnostics block. Prefixes rather than
         whole lines, because the value is written by whichever process last ran it
         and the wording must not depend on which screen is asking. -->
    <string name="diag_gyro_prefix">"Gyro: "</string>
    <string name="diag_map_prefix">"Map: "</string>

    <!-- Toasts -->
    <string name="toast_pick_photo_first">Pick a photo from the gallery first</string>
    <string name="toast_depth_updated">Depth updated</string>

    <string name="action_choose_map">Depth</string>
    <string name="action_image">Image</string>
    <string name="action_calibrate">Calibrate</string>
    <string name="depth_ai_button">Depth AI (ComfyUI)</string>
    <string name="apply_set_as_wallpaper">Set as wallpaper</string>
    <string name="action_cancel">Cancel</string>
    <string name="action_done">Done</string>
    <!-- The grip of every sheet that had none. The bar is now on all of them
         (the user asked for it on the small gallery popups too: without a handle
         a modal had no discoverable way out at all), and the description has to
         name WHICH sheet it closes, because one generic "Close" would make a
         screen reader announce the same control on eight different screens while
         the two that already existed say which sheet they belong to. Spoken,
         never drawn: the bar is a drawn line and needs no label on screen. -->
    <string name="gallery_sort_close">Close the sort sheet</string>
    <string name="gallery_copy_from_close">Close the copy-settings sheet</string>
    <string name="gallery_delete_close">Close the delete question</string>
    <string name="gallery_rename_close">Close the rename sheet</string>
    <string name="gallery_playlist_pick_close">Close the playlist sheet</string>
    <string name="gallery_playlist_new_close">Close the new-playlist sheet</string>
    <string name="apply_close">Close the set-as-wallpaper sheet</string>
    <string name="depth_close">Close the depth sheet</string>
