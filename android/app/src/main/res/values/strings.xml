    <!--
      Triggers are two families and are not interchangeable: a timed one is due
      when a clock says so, an event one when something happens. Grouping them is
      the whole point — a flat list of four says they are the same kind of thing.
      The timed subtitles are elapsed, not "at 07:00", because that is what the
      model means: a calendar day needs a time zone this value cannot see.
    -->
    <string name="playlists_family_timed">Timed</string>
    <string name="playlists_family_event">Event</string>
