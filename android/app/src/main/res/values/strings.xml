    <string name="depth_nudge_up">＋</string>

    <string name="depth_generate">Generate</string>
    <string name="depth_endpoint_required">Set the ComfyUI endpoint first</string>

    <!-- The run. Phases, not controls: the job is queued with the model baked in,
         so a control that appeared to change it could not (R-PANEL7). -->
    <string name="depth_phase_uploading">Uploading the photo</string>
    <string name="depth_phase_queued">Queued on the server</string>
    <string name="depth_phase_working">Working</string>
    <string name="depth_phase_fetching">Fetching the map</string>
    <string name="depth_phase_saving">Saving</string>
    <string name="depth_phase_resuming">Asking the server what happened</string>

    <!--
      A failed run. The headline has to say what SURVIVED: an error that does not
      say that leaves the user unable to tell whether their map is gone, which is
      the worst outcome this app has.
    -->
    <string name="depth_run_cause">The server said: %1$s</string>
    <string name="depth_edit_server">Edit server</string>

    <!--
      The completion notification. R-BG3, decided: a run takes tens of seconds and
      the user has walked away, so silence reads as failure.

      NOTE: this needs android.permission.POST_NOTIFICATIONS to be visible on
      Android 13+. It is NOT in the manifest, so on 33+ the notification is
      suppressed. See DepthGenDialog.notifyOutcome.
    -->
    <string name="depth_notify_channel">Depth generation</string>
