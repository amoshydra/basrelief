<?xml version="1.0" encoding="utf-8"?>
<!--
  The application package/namespace is declared in app/build.gradle
  (AGP 8 no longer allows a package attribute here). That is the only place
  the package name lives; keep it in sync when renaming.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-feature android:name="android.software.live_wallpaper" android:required="false" />
    <uses-feature android:glEsVersion="0x00020000" android:required="true" />
    <uses-permission android:name="android.permission.INTERNET" />
    <!--
         Lets the app re-bind its OWN live wallpaper after the gallery
         selection changes. Normal-level, granted at install, no prompt.

         Without it the system keeps serving the snapshot it took when the
         wallpaper surface appeared, so the home screen keeps showing the
         previously selected photo even though the engine has already
         reloaded the new one. That was the whole of a bug where selecting
         in the gallery appeared to do nothing until Set as wallpaper was
         pressed again.
    -->
    <uses-permission android:name="android.permission.SET_WALLPAPER" />

    <application
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:allowBackup="true"
        android:usesCleartextTraffic="true"
        android:theme="@android:style/Theme.DeviceDefault.NoActionBar">

        <service
            android:name=".DepthWallpaperService"
            android:exported="true"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_WALLPAPER">
            <intent-filter>
                <action android:name="android.service.wallpaper.WallpaperService" />
            </intent-filter>
            <meta-data
                android:name="android.service.wallpaper"
                android:resource="@xml/wallpaper" />
        </service>

        <!--
          singleTask, not singleTop, and not the default.

          This activity is two things at once: the launcher entry, and a share
          target for ACTION_SEND. singleTop only reuses an instance that is
          already at the top of the *current* task, so a share arriving from
          another app started a fresh instance every time and the recents list
          filled with copies of the studio. singleTask guarantees one instance
          system-wide and brings the existing task forward instead.

          The cost of singleTask is that a second intent arrives at onNewIntent
          rather than onCreate, so onNewIntent has to do the work - including
          setIntent, or the activity would keep reporting the first share as its
          intent. It does. Do not "simplify" this to singleTop: the symptom is
          several identical studio windows, not a crash, so it reads as cosmetic
          until the recents list is unusable.

          No taskAffinity override. An empty affinity is the convention for a
          share target that wants a task of its own, but this app is a single
          activity that is also the launcher entry, so separating the two would
          give the user two tasks for one screen - the problem being fixed.
        -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="image/*" />
            </intent-filter>
        </activity>
    </application>
</manifest>
